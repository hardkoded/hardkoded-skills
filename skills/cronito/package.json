{
  "name": "cronito",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive CLI for managing scheduled tasks with a system cron backend. Build-only manifest — end users only need the bundled dist/cronito.js and Node on PATH.",
  "type": "module",
  "scripts": {
    "build": "tsc && node esbuild.config.js",
    "dev": "node --loader ts-node/esm src/cli.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cron-parser": "^4.9.0",
    "dayjs": "^1.11.10",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.5",
    "table": "^6.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
